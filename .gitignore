# ========================================
# Node.js 项目 .gitignore 配置
# 狼人杀小程序服务端项目
# 技术栈: Node.js + TypeScript + Mongoose + Socket.IO + Redis
# ========================================

# ========================================
# 依赖包目录
# 说明: node_modules 包含项目依赖，体积巨大且可通过 package.json 重新安装
# ========================================
node_modules/
.pnpm-store/

# ========================================
# 构建输出目录
# 说明: 编译后的文件不应纳入版本控制，应从源代码重新构建
# ========================================
dist/
build/
out/
*.tsbuildinfo

# ========================================
# 环境变量和配置文件
# 说明: 包含敏感信息（数据库密码、API密钥等），绝对不能提交到版本控制
# ========================================
.env
.env.local
.env.*.local
.env.development
.env.test
.env.production
.env.staging

# ========================================
# IDE 和编辑器配置文件
# 说明: 不同开发者使用不同的IDE，配置文件应保持个性化
# ========================================
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
*.sublime-project
*.sublime-workspace

# ========================================
# 日志文件
# 说明: 日志文件会不断增长，不应纳入版本控制
# ========================================
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# ========================================
# 临时文件和缓存
# 说明: 临时文件和缓存目录会在运行时生成，不应纳入版本控制
# ========================================
.cache/
.parcel-cache/
.nyc_output/
.eslintcache
.stylelintcache
*.tmp
*.temp
.tmp/
.temp/

# ========================================
# 测试覆盖率报告
# 说明: 覆盖率报告是测试结果，每次运行都会变化，不应纳入版本控制
# ========================================
coverage/
*.lcov
.nyc_output/

# ========================================
# 操作系统生成的文件
# 说明: Windows 和 macOS 会自动生成系统文件
# ========================================
Thumbs.db
.DS_Store
.AppleDouble
.LSOverride
._*

# ========================================
# Webpack 相关
# 说明: Webpack 构建过程中的临时文件和缓存
# ========================================
.webpack/
webpack-stats.json
webpack-bundle-analyzer/

# ========================================
# TypeScript 相关
# 说明: TypeScript 编译器生成的文件
# ========================================
*.tsbuildinfo

# ========================================
# 数据库文件
# 说明: 本地数据库文件不应纳入版本控制
# ========================================
*.db
*.sqlite
*.sqlite3

# ========================================
# 上传文件目录
# 说明: 用户上传的文件应存储在文件服务器或对象存储，不应纳入版本控制
# ========================================
uploads/
public/images/userAvatars/*
public/images/ad/*
public/images/clan/*
public/video/*
!public/images/.gitkeep
!public/images/userAvatars/.gitkeep
!public/images/ad/.gitkeep
!public/images/clan/.gitkeep
!public/video/.gitkeep

# ========================================
# Redis 相关
# 说明: Redis 配置和持久化文件
# ========================================
dump.rdb
appendonly.aof

# ========================================
# Docker 相关
# 说明: Docker 运行时生成的文件
# ========================================
.dockerignore

# ========================================
# 备份文件
# 说明: 编辑器自动生成的备份文件
# ========================================
*.bak
*.backup
*~

# ========================================
# 项目特定配置
# 说明: 针对本项目的特定排除规则
# ========================================
# 文档目录中的临时文件
.#md/

# 项目文档（已移至 project-docs/）
document/

# 审计报告（临时文件）
contest_audit_report.md

# ========================================
# 可选：保留的配置文件
# 说明: 以下文件建议纳入版本控制，但需要谨慎处理敏感信息
# ========================================
# .env.example - 环境变量示例文件（不包含真实值）
# .prettierrc.json - 代码格式化配置
# .eslintrc.json - 代码检查配置
# tsconfig.json - TypeScript 配置
# jest.config.ts - Jest 测试配置
