{
  "dependencies": {
    "@vue/reactivity": "^3.5.16",
    "axios": "^1.8.4",
    "bcryptjs": "^2.4.3",
    "body-parser": "^1.20.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.2",
    "mongodb": "^6.13.0",
    "mongoose": "^8.10.0",
    "mongoose-sequence": "6.0.0",
    "multer": "^2.0.2",
    "node-cache": "^5.1.2",
    "node-schedule": "^2.1.1",
    "sharp": "^0.34.2",
    "socket.io": "^4.8.1",
    "type-fest": "^4.39.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.2"
  },
  "type": "commonjs",
  "name": "myserver",
  "version": "1.0.0",
  "main": "index.ts",
  "ts-node": "ts-node",
  "scripts": {
    "build": "cross-env NODE_ENV=development webpack --config config/webpack.dev.js",
    "build:dev": "cross-env NODE_ENV=development webpack --config config/webpack.dev.js",
    "build:prod": "cross-env NODE_ENV=production webpack --config config/webpack.prod.js",
    "start": "node dist/bundle.js",
    "start:dev": "node inspect dist/bundle.js",
    "start:prod": "cross-env NODE_ENV=production node dist/bundle.js",
    "dev": "cross-env NODE_ENV=development webpack --config config/webpack.dev.js && pnpm run start",
    "dev:watch": "cross-env NODE_ENV=development webpack --config config/webpack.dev.js --watch",
    "dev:hot": "cross-env NODE_ENV=development ts-node-dev --respawn --transpile-only src/index.ts",
    "typecheck": "tsc --noEmit",
    "typecheck:watch": "tsc --noEmit --watch",
    "lint": "eslint . --ext .ts,.js,.mts",
    "lint:fix": "eslint . --ext .ts,.js,.mts --fix",
    "lint:md": "eslint . --ext .md",
    "quality": "pnpm run typecheck && pnpm run lint",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --testPathPattern=src/models/",
    "test:integration": "jest --testPathPattern=src/test/",
    "test:specific": "jest --testPathPattern=",
    "prod": "cross-env NODE_ENV=production webpack --config config/webpack.prod.js",
    "analyze": "cross-env NODE_ENV=production webpack --config config/webpack.prod.js --profile --json > stats.json && webpack-bundle-analyzer stats.json",
    "deploy:dev": "pnpm run quality && pnpm run test && pnpm run build:dev && pnpm run start:dev",
    "deploy:prod": "pnpm run quality && pnpm run test && pnpm run build:prod",
    "predeploy": "pnpm run quality && pnpm run test",
    "clean": "rm -rf dist/ node_modules/.cache/",
    "clean:all": "rm -rf dist/ node_modules/ pnpm-lock.yaml",
    "cache:warmup": "ts-node src/utils/cacheWarmup.ts",
    "docker:build": "docker build -t myserver .",
    "docker:run": "docker run -p 3000:3000 myserver",
    "profile": "node --prof dist/bundle.js",
    "profile:analyze": "node --prof-process isolate-*.log > profile.txt",
    "profile:cpu": "cross-env NODE_ENV=production node --cpu-prof dist/bundle.js",
    "profile:memory": "cross-env NODE_ENV=production node --heap-prof dist/bundle.js",
    "health": "ts-node src/utils/healthCheck.ts",
    "monitor": "ts-node src/utils/monitor.ts",
    "debug": "cross-env NODE_ENV=development ts-node --inspect src/index.ts",
    "debug:break": "cross-env NODE_ENV=development ts-node --inspect-brk src/index.ts",
    "deps:update": "pnpm update",
    "deps:update:major": "pnpm update --major",
    "deps:update:minor": "pnpm update --minor",
    "deps:update:patch": "pnpm update --patch",
    "deps:check": "pnpm outdated",
    "backup": "echo 'Backup not implemented yet'",
    "restore": "echo 'Restore not implemented yet'",
    "info": "echo \"Project: myserver\" && echo \"Version: \"$(node -p \"require('./package.json').version\")",
    "version": "echo \"Version: \"$(node -p \"require('./package.json').version\")"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@eslint/markdown": "^7.5.1",
    "@import-meta-env/unplugin": "^0.6.3",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.3.0",
    "@swc/core": "^1.11.21",
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/ioredis": "^4.28.10",
    "@types/jest": "^29.5.14",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/mongoose-sequence": "^3.0.11",
    "@types/multer": "^1.4.12",
    "@types/node": "^25.0.3",
    "@types/node-schedule": "^2.1.7",
    "@types/ws": "^8.18.0",
    "apicache": "^1.6.3",
    "compression-webpack-plugin": "^11.1.0",
    "cross-env": "^7.0.3",
    "esbuild": "^0.25.1",
    "esbuild-register": "^3.6.0",
    "eslint": "^9.39.2",
    "eslint-config-prettier": "^10.1.8",
    "eslint-config-standard": "^17.1.0",
    "eslint-plugin-prettier": "^5.5.4",
    "fork-ts-checker-webpack-plugin": "^9.1.0",
    "globals": "^16.5.0",
    "image-webpack-loader": "^8.1.0",
    "jest": "^29.7.0",
    "jiti": "^2.6.1",
    "prettier": "^3.7.4",
    "process": "^0.11.10",
    "rollup-plugin-copy": "^3.5.0",
    "socket.io-client": "^4.8.1",
    "supertest": "^7.1.4",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "swc-loader": "^0.2.6",
    "terser-webpack-plugin": "^5.3.14",
    "thread-loader": "^4.0.4",
    "ts-jest": "^29.3.2",
    "ts-loader": "^9.5.2",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "tsconfig-paths": "^4.2.0",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.50.0",
    "vite": "^7.2.7",
    "webpack": "^5.98.0",
    "webpack-bundle-analyzer": "^4.10.2",
    "webpack-cli": "^6.0.1",
    "webpack-dev-server": "^5.2.0",
    "webpack-merge": "^6.0.1",
    "webpack-node-externals": "^3.0.0"
  }
}